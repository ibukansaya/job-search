# Discord Webhook URL (Required for notifications)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# Delay between Discord webhook batches in ms (Default: 2500)
DISCORD_DELAY_MS="2500"

# 9Router AI Gateway (Optional: set AI_ENRICH_ENABLED=true to activate)
NINEROUTER_BASE_URL="http://127.0.0.1:20128/v1"
NINEROUTER_API_KEY="sk-dummy"
NINEROUTER_MODEL="openai/gpt-4o-mini"
AI_ENRICH_ENABLED="false"

# Server / container timezone (e.g. Asia/Jakarta, UTC, Asia/Singapore)
TZ="Asia/Jakarta"

# Schedule Options:
# Option A: Run daily at a fixed wall-clock time (HH:MM in server local time, e.g. "08:00")
SCHEDULE_DAILY_AT="08:00"

# Option B: Fixed interval in hours (used if SCHEDULE_DAILY_AT is empty, default: 24)
SCRAPE_INTERVAL_HOURS="24"

# Run a scrape immediately upon container boot before entering schedule (true/false, default: true)
RUN_ON_BOOT="true"
